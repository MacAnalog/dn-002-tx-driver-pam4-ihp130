# python / jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.venv/
.DS_Store
# notebooks are generated from the paired .py files via jupytext
notebooks/*.ipynb
# machine-specific tool locations for the Makefile
local.mk

# regenerable EDA outputs (gen_layout.py / signoff.py / pex_sim.py / kpex).
# PNG renders and converted post-layout netlists directly under
# layout/out(/pex) ARE tracked so every result reproduces without the
# layout toolchain installed. GDS is NOT tracked — it regenerates
# byte-for-byte from gen_layout.py (gdsfactory) given the same params.
*.gds
# kpex working dirs (nomim GDS, lvsdb, oas, rdb):
layout/out/pex/*/
# DRC/LVS run dirs (lyrdb, logs, extracted cir):
layout/out/signoff/
.kpex_cache/
# optimizer trial workspaces + NB2 baseline:
notebooks/nb_opt/
# stray KLayout-LVS by-products (dumped into cwd):
*_lay_extracted.cir
*.lyrdb
*.log
# ngspice raw outputs:
*.raw
# co-design runs (per-trial GDS/DRC/LVS/PEX artifacts) — harvested into layout/codesign/results/
layout/codesign/runs/
layout/codesign/logs/

# reviewer report scratch (regenerable: make report)
report/work/
# the report keeps its own GDS next to the DRC/LVS/PEX evidence
!report/layout/*/dut_pam4.gds
!report/layout/*/signoff/*/*.log

# scratch project_setup copies written by codesign/remeasure.py
layout/codesign/_rm_*_project_setup.yaml
# verification scratch: deck outputs + DRC/LVS/regen work dirs (decks + expected.json ARE tracked)
verification/decks/*/*.csv
verification/work/
# EM lane scratch: FDTD run data + cut GDS are regenerable (layout/em/README.md);
# only the port map, netlists, manifest, touchstone and fitted subckt are results
layout/em/target/em_out/sub-*
layout/em/target/*.gds
